# ─────────────────────────────────────────────────────────────────────────────
# QomSu / Comrade API — Environment Template
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# Every value here is optional unless marked REQUIRED.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core Django ──────────────────────────────────────────────────────────────
# REQUIRED. Use a long random string: `python -c "import secrets; print(secrets.token_urlsafe(64))"`
SECRET_KEY=

# Set to True only for local development.
DEBUG=False

# development | staging | production
ENVIRONMENT=development

# Comma-separated list of allowed hosts (Django ALLOWED_HOSTS).
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# ── Database ─────────────────────────────────────────────────────────────────
# Leave unset to use the bundled SQLite (local dev).
# For Postgres (prod/Docker): postgres://user:pass@host:5432/dbname
DATABASE_URL=

# ── Security / HTTPS ─────────────────────────────────────────────────────────
# These default to `not DEBUG`; override explicitly when needed.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from browsers.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=

# ── Frontend ─────────────────────────────────────────────────────────────────
# URL of the web frontend (used for redirects). Trailing slash included.
FRONTEND_URL=http://localhost:5173/

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# ── Rate limits (DRF throttles) ──────────────────────────────────────────────
RATE_LIMIT_ANON=100/hour
RATE_LIMIT_USER=1000/hour
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_OTP=3/hour
RATE_LIMIT_PAYMENT=20/hour
RATE_LIMIT_UPLOAD=50/hour

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Local dev: EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ── Twilio SMS ───────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
COUNTRY_CODE=

# ── Redis / Celery / Channels ────────────────────────────────────────────────
# Local dev (Docker): redis://redis:6379/0 ; bare metal: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Payment providers (fill in only those you use) ───────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORTCODE=
MPESA_PASSKEY=
MPESA_API_URL=https://sandbox.safaricom.co.ke
MPESA_STK_PUSH_URL=https://sandbox.safaricom.co.ke/mpesa/stkpush/v1/processrequest
MPESA_CALLBACK_URL=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_ENVIRONMENT=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENVIRONMENT=sandbox
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_ENVIRONMENT=sandbox
EQUITY_API_KEY=
EQUITY_CONSUMER_SECRET=
EQUITY_MERCHANT_CODE=
EQUITY_API_URL=https://uat.jengahq.io

# Currency API (CurrencyBeacon)
CURRENCY_API_KEY=
CURRENCY_API_PROVIDER=currencybeacon

# ── Social / OAuth (optional) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GITHUB_CLIENT_ID=
GITHUB_SECRET_KEY=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ── Error tracking (optional) ────────────────────────────────────────────────
SENTRY_DSN=

# ── AI / ML (optional) ───────────────────────────────────────────────────────
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ELEVENLABS_API_KEY=
QOMAI_MODEL=
HF_TOKEN=
